    },
    {
      "type": "number",
      "id": "products_limit_4",
      "label": "Number of products to display for Collection 4",
      "default": 8
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "number",
      "id": "products_limit_5",
      "label": "Number of products to display for Collection 5",
      "default": 8
    },
    {
      "type": "collection",
      "id": "collection_6",
