{% comment %}
    Renders a list of product's price (regular, sale, unit) in both BGN and EUR
    Accompanies product forms and meant to be updated dynamically
    Accepts:
    - variant: {Object} Variant Liquid object (optional)
    - product: {Object} Product Liquid object (optional)
    - show_vendor: {Boolean} Show the product's vendor depending on the section setting (optional)

    Usage:
    {% include 'product-price', variant: current_variant, product: product %}
{% endcomment %}
{%- liquid
  if variant.title
    assign compare_at_price = variant.compare_at_price
    assign price = variant.price
    assign available = variant.available
  else
    assign compare_at_price = 1999
    assign price = 1999
    assign available = true
  endif

  assign money_price = price | money
  
  # BGN conversion rate: 1 EUR = 1.95583 BGN
  assign bgn_conversion_rate = 1.95583
  assign price_bgn = price | times: bgn_conversion_rate | times: 100 | round | divided_by: 100.0
  assign compare_at_price_bgn = compare_at_price | times: bgn_conversion_rate | times: 100 | round | divided_by: 100.0
-%}

{% comment %} {% if product.compare_at_price_max > product.price %}
СПЕСТЯВАТЕ ({{ product.compare_at_price | minus: product.price | money }}/€{{ product.compare_at_price | minus: product.price | divided_by: eur_conversion_rate | times: 100 | round | divided_by: 100.0 | money_without_currency }})
{% endif %} {% endcomment %}

<dl class="price
  {% if available == false %} price--sold-out {% endif %}
  {% if compare_at_price > price %} price--on-sale {% endif %}
  {% if variant.unit_price_measurement %} price--unit-available {% endif %}"
  data-price
>

  {% if show_vendor and product %}
    <div class="price__vendor">
      <dt>
        <span class="visually-hidden">{{ 'products.product.vendor' | t }}</span>
      </dt>
      <dd>
        {{ product.vendor }}
      </dd>
    </div>
  {% endif %}

  {%- comment -%}
    Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
      - div.price__unit: Displayed when the first variant has a unit price
      - div.price__availability: Displayed when the product is sold out
  {%- endcomment -%}
  <div class="price__pricing-group">
    <div class="price__regular">
      <dt>
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.regular_price' | t }}</span>
      </dt>
      <dd>
        <span class="price-item price-item--regular" data-regular-price>
          {{ money_price }} <span data-nosnippet>({{ price_bgn | money_without_currency }} лв.)</span>
        </span>
      </dd>
    </div>

    <div class="price__sale">
      <dt>
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.sale_price' | t }}</span>
      </dt>
      <dd>
        <span class="price-item price-item--sale" data-sale-price>
          {{ money_price }} <span data-nosnippet>({{ price_bgn | money_without_currency }} лв.)</span>
        </span>
      </dd>

      <dt>
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.regular_price' | t }}</span>
      </dt>
      <dd>
        <s class="price-item price-item--regular" data-regular-price>
          {% comment %} {{ compare_at_price | money }}/{{ compare_at_price_bgn | money_without_currency }}лв {% endcomment %}
          {{ compare_at_price | money }}
        </s>
      </dd>
    </div>
    
    <div class="price__badges">
      <span class="price__badge price__badge--sale" aria-hidden="true">
        <span class="sale-badge1">-{{ compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round }}%</span>
      </span>
      <span class="price__badge price__badge--sold-out">
        <span>{{ 'products.product.sold_out' | t }}</span>
      </span>
    </div>
  </div>
  
  {% if variant.unit_price_measurement %}
  <div class="price__unit">
    <dt>
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.unit_price_label' | t }}</span>
    </dt>
    <dd class="price-unit-price">
      {%- capture unit_price_separator -%}
        <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- endcapture -%}
      {%- capture unit_price_base_unit -%}
        <span data-unit-price-base-unit>
          {%- if variant.unit_price_measurement.reference_value != 1 -%}
            {{- variant.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ variant.unit_price_measurement.reference_unit }}
        </span>
      {%- endcapture -%}

      <span data-unit-price>{{ variant.unit_price | money }} <span data-nosnippet>({{ variant.unit_price | times: bgn_conversion_rate | times: 100 | round | divided_by: 100.0 | money_without_currency }} лв.)</span></span>{{- unit_price_separator -}}{{- unit_price_base_unit -}}
    </dd>
  </div>
  {% endif %}
</dl>


